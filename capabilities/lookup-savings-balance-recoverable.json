{
  "capabilityId": "lookup-savings-balance-recoverable",
  "version": 1,
  "description": "Same as lookup-savings-balance, but exercised against a member whose flow includes a dismissible session-notice interstitial (V3 error-taxonomy demo).",
  "inputSchema": { "memberId": "string" },
  "outputSchema": { "balance": "string" },
  "steps": [
    {
      "index": 0,
      "action": "type",
      "target": {
        "strategies": [
          { "kind": "role", "value": "textbox", "meta": { "name": "Member ID" } },
          { "kind": "cssPath", "value": "#memberIdInput" }
        ]
      },
      "valueTemplate": "{{memberId}}",
      "timeoutMs": 5000,
      "retry": { "max": 1, "backoffMs": 200 }
    },
    {
      "index": 1,
      "action": "click",
      "target": {
        "strategies": [
          { "kind": "role", "value": "button", "meta": { "name": "Search" } },
          { "kind": "cssPath", "value": "input[type=submit]" }
        ]
      },
      "timeoutMs": 5000,
      "retry": { "max": 1, "backoffMs": 200 }
    },
    {
      "index": 2,
      "action": "extract",
      "target": {
        "strategies": [
          { "kind": "cssPath", "value": "table[border='1'] tr:has-text('Savings Balance') td:nth-child(2)" }
        ]
      },
      "extractAs": "balance",
      "timeoutMs": 5000,
      "retry": { "max": 1, "backoffMs": 200 }
    }
  ],
  "successCondition": {
    "kind": "elementText",
    "target": { "strategies": [{ "kind": "text", "value": "Savings Balance" }] },
    "expected": "Savings Balance"
  },
  "recoveryRules": [
    {
      "matchCondition": {
        "kind": "elementVisible",
        "target": { "strategies": [{ "kind": "role", "value": "link", "meta": { "name": "Continue" } }] }
      },
      "action": "dismiss",
      "maxApplications": 1
    }
  ],
  "allowlistScope": {
    "domains": ["localhost"],
    "actions": ["click", "type", "navigate", "waitFor", "extract"]
  },
  "createdFrom": {
    "discoveryRunId": "hand-authored-v3",
    "timestamp": "2026-08-14T00:00:00.000Z"
  }
}
