{
  "capabilityId": "lookup-savings-balance-risky-demo",
  "version": 1,
  "description": "Demo artifact for V4: identical to lookup-savings-balance, but its Search click step is marked risky:true to demonstrate the guardrail confirm gate (see DECISIONS.md / README.md V4 section). Not a realistic risky action on its own — a real risky action would be something like submitting the new-subaccount form.",
  "inputSchema": {
    "memberId": "string"
  },
  "outputSchema": {
    "balance": "string"
  },
  "steps": [
    {
      "index": 0,
      "action": "type",
      "target": {
        "strategies": [
          {
            "kind": "role",
            "value": "textbox",
            "meta": {
              "name": "Member ID"
            }
          },
          {
            "kind": "cssPath",
            "value": "#memberIdInput"
          }
        ]
      },
      "valueTemplate": "{{memberId}}",
      "timeoutMs": 5000,
      "retry": {
        "max": 1,
        "backoffMs": 200
      }
    },
    {
      "index": 1,
      "action": "click",
      "target": {
        "strategies": [
          {
            "kind": "role",
            "value": "button",
            "meta": {
              "name": "Search"
            }
          },
          {
            "kind": "cssPath",
            "value": "input[type=submit]"
          }
        ]
      },
      "timeoutMs": 5000,
      "retry": {
        "max": 1,
        "backoffMs": 200
      },
      "risky": true
    },
    {
      "index": 2,
      "action": "extract",
      "target": {
        "strategies": [
          {
            "kind": "cssPath",
            "value": "table[border='1'] tr:has-text('Savings Balance') td:nth-child(2)"
          }
        ]
      },
      "extractAs": "balance",
      "timeoutMs": 5000,
      "retry": {
        "max": 1,
        "backoffMs": 200
      }
    }
  ],
  "successCondition": {
    "kind": "elementText",
    "target": {
      "strategies": [
        {
          "kind": "text",
          "value": "Savings Balance"
        }
      ]
    },
    "expected": "Savings Balance"
  },
  "recoveryRules": [],
  "allowlistScope": {
    "domains": [
      "localhost"
    ],
    "actions": [
      "click",
      "type",
      "navigate",
      "waitFor",
      "extract"
    ]
  },
  "createdFrom": {
    "discoveryRunId": "hand-authored-v0",
    "timestamp": "2026-08-14T00:00:00.000Z"
  }
