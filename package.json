{
  "name": "agent-hands",
  "version": "0.1.0",
  "description": "Computer-use automation: LLM discovers a UI flow once, records it as a typed replayable capability, replays deterministically without the model in the loop.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "run-agent": "tsx src/cli.ts run-agent",
    "replay": "tsx src/cli.ts replay",
    "target-app": "tsx target-app/server.ts",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "playwright": "^1.48.0",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.7.0",
    "@types/express": "^4.17.21"
  }
}
